# HTTP server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
STREAMER_CHANNEL=nebedolagy
WTV_CHANNEL_URL=https://w.tv/bedolagy
WTV_CHAT_ID=019b3308-bce6-712a-9deb-85ed439c4c1a
WTV_CHAT_API=https://chats-service.w.tv

# SQLite file location (relative paths resolve from backend/)
SQLITE_FILE=./raffle.sqlite

# Server-side dashboard login. Generate values with: npm run auth:generate --workspace backend
# Prefer ADMIN_PASSWORD_HASH in production; ADMIN_PASSWORD is optional for local convenience.
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Kick's public chat realtime transport. This is an undocumented interface and
# may change; set KICK_PUSHER_URL if Kick rotates its public realtime endpoint.
KICK_API_BASE=https://kick.com
KICK_PUSHER_URL=wss://ws-us2.pusher.com/app/32cbd69e4b950bf97679?protocol=7&client=js&version=8.4.0&flash=false
KICK_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Safari/537.36
